{
  "name": "codenow-oj",
  "version": "0.1.0",
  "description": "CodeNow OJ desktop application",
  "author": "Bamzc",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vinext-windows.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "desktop:dev": "npm run build && electron .",
    "desktop:rebuild-native": "electron-rebuild --force --only better-sqlite3",
    "desktop:restore-native": "npm rebuild better-sqlite3",
    "desktop:pack": "npm run build && npm run desktop:rebuild-native && electron-builder --projectDir desktop --dir && npm run desktop:restore-native",
    "desktop:package": "npm run build && npm run desktop:rebuild-native && electron-builder --projectDir desktop --win nsis && npm run desktop:restore-native",
    "test": "npm run build && npm run test:unit && node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --exclude tests/e2e/** --exclude tests/unit/split-catalog-safety.test.mjs && node --test tests/unit/split-catalog-safety.test.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "admin:bootstrap:local": "node scripts/bootstrap-admin.mjs --target local",
    "release:preview": "node scripts/release-cloudflare.mjs preview",
    "release:production": "node scripts/release-cloudflare.mjs production"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@monaco-editor/react": "^4.7.0",
    "better-auth": "1.6.25",
    "better-sqlite3": "12.11.1",
    "dompurify": "3.4.8",
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.1",
    "marked": "14.0.0",
    "monaco-editor": "^0.56.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "6.18.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electron/rebuild": "4.0.3",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "claude-skills-frontend": "^1.4.0",
    "drizzle-kit": "0.31.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "29.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
