{"id":"CL002","title":"约瑟夫环","difficulty":"入门","time":"1000 ms","memory":"128 MB","description":"n 个人围成一圈，从 1 号开始按顺时针 1 到 m 报数，报到 m 的人出列，下一人重新从 1 开始报数，如此往复。求最后留下的人的编号。","inputFormat":"一行两个整数 n 和 m（1 ≤ n ≤ 1000000，1 ≤ m ≤ 1000000000）。","outputFormat":"一个整数，最后留下的人的编号（从 1 开始）。","samples":[{"id":1,"input":"5 2\n","output":"3\n","category":"sample","scale":1,"targets":"经典小样例","reason":"答案 3，便于手推"},{"id":2,"input":"6 7\n","output":"5\n","category":"sample","scale":1,"targets":"m 大于 n","reason":"报数跨过整圈"},{"id":3,"input":"1 1\n","output":"1\n","category":"boundary","scale":1,"targets":"单人成环","reason":"n=1 直接留下"},{"id":4,"input":"1 1000000000\n","output":"1\n","category":"boundary","scale":1,"targets":"单人+最大 m","reason":"m 极大不影响单人"},{"id":5,"input":"2 1\n","output":"2\n","category":"boundary","scale":1,"targets":"最小非平凡环","reason":"首轮即淘汰 1 号"},{"id":6,"input":"10 1\n","output":"10\n","category":"special","scale":1,"targets":"m=1 顺序出列","reason":"答案恒为 n"},{"id":7,"input":"7 1000000000\n","output":"5\n","category":"special","scale":1,"targets":"极大 m 取模","reason":"卡逐步报数模拟"},{"id":8,"input":"1000000 3\n","output":"637798\n","category":"performance","scale":20000,"targets":"卡 O(n·m) 与链表模拟","reason":"必须 O(n) 递推"},{"id":9,"input":"999983 999979\n","output":"261611\n","category":"performance","scale":999983,"targets":"大 n 大 m 组合","reason":"质数规模防特例"},{"id":10,"input":"13 13\n","output":"8\n","category":"adversarial","scale":1,"targets":"m 恰等于 n","reason":"整圈回到起点的报数"},{"id":11,"input":"37 17\n","output":"9\n","category":"ordinary","scale":1,"targets":"随机小环","reason":"与暴力模拟对拍"},{"id":12,"input":"43 11\n","output":"28\n","category":"ordinary","scale":1,"targets":"随机小环","reason":"与暴力模拟对拍"},{"id":13,"input":"26 34\n","output":"9\n","category":"ordinary","scale":1,"targets":"随机小环","reason":"与暴力模拟对拍"}],"folder":"经典题库/枚举与模拟","sourceUrl":"","extractionStatus":"complete"}