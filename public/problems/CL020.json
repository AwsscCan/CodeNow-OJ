{"id":"CL020","title":"组合数取模","difficulty":"普及","time":"1000 ms","memory":"128 MB","description":"给定 n 和 m，求组合数 C(n, m) 对 1000000007 取模的结果。约定当 m < 0 或 m > n 时结果为 0。","inputFormat":"一行两个整数 n 和 m（0 ≤ n ≤ 1000000，-1 ≤ m ≤ 1000000）。","outputFormat":"一个整数，C(n, m) mod 1000000007。","samples":[{"id":1,"input":"5 2\n","output":"10\n","category":"sample","scale":1,"targets":"基础组合","reason":"10"},{"id":2,"input":"0 0\n","output":"1\n","category":"boundary","scale":1,"targets":"C(0,0)","reason":"1"},{"id":3,"input":"10 0\n","output":"1\n","category":"boundary","scale":1,"targets":"取零个","reason":"1"},{"id":4,"input":"5 -1\n","output":"0\n","category":"boundary","scale":1,"targets":"m 为负","reason":"0"},{"id":5,"input":"3 5\n","output":"0\n","category":"special","scale":1,"targets":"m 超过 n","reason":"0"},{"id":6,"input":"1000000 500000\n","output":"996692777\n","category":"performance","scale":1000000,"targets":"百万级卡阶乘 O(n) 逆元","reason":"费马小定理"},{"id":7,"input":"1000000 1\n","output":"1000000\n","category":"performance","scale":1000000,"targets":"取一个的大 n","reason":"答案 n mod p"},{"id":8,"input":"62 31\n","output":"997262645\n","category":"adversarial","scale":1,"targets":"中等 n 跨取模边界","reason":"C(62,31) 超 1e9+7"},{"id":9,"input":"36 15\n","output":"567902525\n","category":"ordinary","scale":1,"targets":"随机小组合","reason":"与杨辉三角对拍"},{"id":10,"input":"42 11\n","output":"280561348\n","category":"ordinary","scale":1,"targets":"随机小组合","reason":"与杨辉三角对拍"},{"id":11,"input":"25 21\n","output":"12650\n","category":"ordinary","scale":1,"targets":"随机小组合","reason":"与杨辉三角对拍"},{"id":12,"input":"60 48\n","output":"358835182\n","category":"ordinary","scale":1,"targets":"随机小组合","reason":"与杨辉三角对拍"},{"id":13,"input":"60 19\n","output":"183640286\n","category":"ordinary","scale":1,"targets":"随机小组合","reason":"与杨辉三角对拍"}],"folder":"经典题库/数论进阶","sourceUrl":"","extractionStatus":"complete"}